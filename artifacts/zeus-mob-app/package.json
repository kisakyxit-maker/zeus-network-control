    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "expo": "~52.0.0",
    "expo-battery": "~10.0.8",
    "expo-constants": "~17.0.3",
    "expo-device": "~7.0.1",
    "expo-status-bar": "~2.0.0",
    "metro": "~0.81.5",
    "metro-config": "~0.81.5",
    "metro-resolver": "~0.81.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-view-shot": "^5.1.0",
    "react-native-web": "~0.19.13",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.29.5",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
